# =============================================================================
# ShopAssist AI Assistant - Environment Configuration
# =============================================================================

# Primary LLM Provider: "mock", "custom", "openai", "gemini", "vllm"
PRIMARY_PROVIDER=custom

# Custom OpenAI-compatible Provider (e.g. MiMo, AnyScale, Together, Local vLLM/Ollama)
CUSTOM_BASE_URL=https://api.xiaomimimo.com/v1
CUSTOM_API_KEY=your_api_key_here
CUSTOM_MODEL=mimo-v2.5-pro

# OpenAI Configuration (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local vLLM / Ollama Configuration (optional)
VLLM_ENDPOINT=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Server Configuration
HOST=0.0.0.0
PORT=8000
UI_PORT=8501
ENVIRONMENT=development
